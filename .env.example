# Required for live Gemini generation. Get a key from Google AI Studio.
GEMINI_API_KEY=

# Current model defaults. You can override these without changing code.
# The project keeps separate workout (Pro-style) and nutrition (Flash-style) roles.
GEMINI_WORKOUT_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash

# Set false to use deterministic local demo responses without Gemini.
AI_ENABLED=true

DATABASE_URL=sqlite:///./data/fitbuddy.db
APP_NAME=FitBuddy – AI Fitness Plan Generator
ADMIN_TOKEN=change-me

# Optional safety/configuration
MAX_FEEDBACK_LENGTH=1000
